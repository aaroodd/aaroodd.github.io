@article{Benso:2021hhh,
    author = "Benso, Cristina and Rodejohann, Werner and Sen, Manibrata and Ramachandran, Aaroodd Ujjayini",
    title = "{Sterile neutrino dark matter production in presence of nonstandard neutrino self-interactions: An EFT approach}",
